---
// UI icons: Phosphor Icons, light weight (MIT). Files live in src/assets/ui.
const files = import.meta.glob<string>('../assets/ui/*.svg', { query: '?raw', import: 'default', eager: true });
const alias: Record<string, string> = { mail: 'envelope-simple', pin: 'map-pin', download: 'download-simple', close: 'x', menu: 'list' };
interface Props { name: string; class?: string }
const { name, class: cls } = Astro.props;
const raw = files[`../assets/ui/${alias[name] ?? name}.svg`] ?? '';
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---
<svg class:list={['ico', cls]} viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false" set:html={inner} />
