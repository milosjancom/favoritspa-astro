---
import { W, WP, LIGHT } from '../data/img';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { lines, euro } from '../data/site';
import { t, url, persons, type Lang } from '../i18n';
interface Props { products: CollectionEntry<'products'>[]; lang: Lang; heading?: boolean }
const { products, lang, heading = true } = Astro.props;
const tr = t(lang);
const groups = (Object.keys(lines) as (keyof typeof lines)[])
  .map((line) => ({ ...lines[line], items: products.filter((p) => p.data.line === line).sort((a, b) => a.data.order - b.data.order) }))
  .filter((g) => g.items.length);
const seq = groups.flatMap((g) => g.items.map((p) => p.data.slug));
---
<section class="lineup" aria-labelledby={heading ? 'lineup-h' : undefined} aria-label={heading ? undefined : tr('lineup.h')}>
  <div class="wrap">
    {heading && (
      <div class="head">
        <h2 id="lineup-h" class="h2">{tr('lineup.h')}</h2>
        <p class="lede">{tr('lineup.p')}</p>
      </div>
    )}
    <div class="stage" data-lineup>
      <div class="scale" aria-hidden="true"><span class="bar"></span><span>1 m</span></div>
      <div class="groups">
        {groups.map((g) => (
          <div class={`group line-${g.key}`}>
            <p class="group-label"><span class="gl-dot"></span><span class="gl-name">{g.label}</span><span class="gl-n">{g.items.length}</span></p>
            <ul>
              {g.items.map((p) => (
                <li style={`--mm:${p.data.dimsMm[0]};--k:${seq.indexOf(p.data.slug)}`}>
                  <a href={url(lang, 'models', p.data.slug)}>
                    <span class="tub"><Image src={p.data.plan} alt={`${p.data.name}, ${tr('lineup.topView')}`} {...WP([320, 640])} sizes="(max-width: 760px) 45vw, 22vw" format="webp" quality={80} /></span>
                    <span class="name">{p.data.name}</span>
                    <span class="meta">{p.data.dimensions}<br />{persons(lang)(p.data.persons)}, {tr('from')} {euro(p.data.fromPrice, lang)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-lineup]').forEach((el) => {
    if (!('IntersectionObserver' in window)) return;
    el.classList.add('js');
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { el.classList.add('in'); io.disconnect(); } }, { threshold: 0.15 });
    io.observe(el);
  });
</script>
<style>
  /* One scale for all tubs: 9 700 mm across the full width. Effect line gets its own row; Midl and Entry share the second. */
  .lineup { background: var(--stone); padding-block: clamp(64px, 9vw, 120px); }
  .head { margin-bottom: clamp(32px, 5vw, 56px); display: flex; flex-direction: column; gap: 14px; }
  .stage { container-type: inline-size; }
  .groups, .scale { --u: calc(100cqw / 9700); }
  .groups { display: flex; flex-wrap: wrap; gap: 5cqw 6cqw; align-items: flex-start; }
  .line-effect { flex: 1 0 100%; }
  .group-label { max-width: none; display: flex; align-items: center; gap: 12px; margin: 0 0 24px; padding-bottom: 12px; border-bottom: 2px solid var(--c); font-size: clamp(1.15rem, 1.6vw, 1.45rem); font-weight: 400; letter-spacing: 0.01em; color: var(--ink); }
  .gl-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 5px color-mix(in srgb, var(--c) 25%, transparent); }
  .gl-n { margin-left: auto; min-width: 28px; height: 28px; display: inline-grid; place-items: center; border-radius: 999px; background: color-mix(in srgb, var(--c) 22%, transparent); font-size: 0.85rem; }
  /* Tubs fade in one after another when the lineup comes into view. */
  [data-lineup].js li { opacity: 0; transform: translateY(26px) scale(0.94); transition: opacity 0.9s ease, transform 1.1s cubic-bezier(.2,.7,.2,1); transition-delay: calc(var(--k) * 130ms); }
  [data-lineup].js.in li { opacity: 1; transform: none; }
  [data-lineup].js .group-label { opacity: 0; transition: opacity 0.8s ease; }
  [data-lineup].js.in .group-label { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { [data-lineup].js li, [data-lineup].js .group-label { opacity: 1; transform: none; } }
  ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: flex-start; gap: 3.2cqw; }
  li { flex: none; }
  .tub { display: flex; align-items: center; height: calc(2180 * var(--u)); }
  .tub img { width: calc(var(--mm) * var(--u)); filter: drop-shadow(0 18px 26px rgb(46 42 37 / 0.2)); transition: transform 0.5s cubic-bezier(.2,.7,.2,1); }
  a:hover .tub img { transform: translateY(-6px); }
  .name { display: block; font-size: clamp(1.2rem, 2cqw, 1.7rem); font-weight: 400; margin-top: 18px; line-height: 1.1; }
  .meta { display: block; font-size: 0.85rem; color: var(--soft); margin-top: 6px; line-height: 1.45; }
  .scale { display: flex; align-items: center; gap: 10px; font-size: 0.8rem; color: var(--soft); margin-bottom: 28px; }
  .bar { display: block; width: calc(1000 * var(--u)); height: 8px; border: 1px solid var(--soft); border-top: 0; }
  @media (max-width: 760px) {
    .groups, .scale { --u: calc(100cqw / 4600); }
    .groups { flex-direction: column; gap: 40px; }
    ul { flex-wrap: wrap; gap: 28px 6cqw; }
  }
</style>
