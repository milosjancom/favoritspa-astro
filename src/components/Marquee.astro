---
// Two rows of customer installation photos drifting in opposite directions.
import { Image } from 'astro:assets';
import { allInstalls } from '../data/installs';
import { LIGHT } from '../data/img';
interface Props { alt: string }
const { alt } = Astro.props;
const all = allInstalls();
const half = Math.ceil(all.length / 2);
const rows = [all.slice(0, half), all.slice(half)];
---
<div class="mq" aria-label={alt}>
  {rows.map((row, r) => (
    <div class:list={['mq-row', { 'mq-rev': r === 1 }]} style={`--n:${row.length}`}>
      <div class="mq-track">
        {[...row, ...row].map((src, i) => (
          <figure class="mq-item" aria-hidden={i >= row.length ? 'true' : undefined}>
            <Image src={src} alt={i < row.length ? alt : ''} {...(LIGHT ? { width: 1600, quality: 76 } : { widths: [320, 560], sizes: '(max-width: 700px) 42vw, 280px', quality: 72 })} format="webp" loading="lazy" />
          </figure>
        ))}
      </div>
    </div>
  ))}
</div>
<style>
  .mq { display: flex; flex-direction: column; gap: clamp(10px, 1.2vw, 16px); overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .mq-row { --size: clamp(150px, 19vw, 280px); --gap: clamp(10px, 1.2vw, 16px); }
  .mq-track { display: flex; gap: var(--gap); width: max-content; animation: mq calc(var(--n) * 6s) linear infinite; }
  .mq-rev .mq-track { animation-direction: reverse; }
  .mq-rev { padding-left: calc(var(--size) / 2); }
  .mq:hover .mq-track { animation-play-state: paused; }
  .mq-item { margin: 0; width: var(--size); flex: none; overflow: hidden; border-radius: 3px; }
  .mq-item :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .mq-item:hover :global(img) { transform: scale(1.06); }
  @keyframes mq { to { transform: translateX(calc(-50% - var(--gap) / 2)); } }
  @media (prefers-reduced-motion: reduce) { .mq-track { animation: none; } .mq { overflow-x: auto; } }
</style>
