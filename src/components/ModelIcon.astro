---
// Small model icon from the original Favorit site (tub outline per model), recoloured with currentColor.
interface Props { slug: string; class?: string }
const { slug, class: cls } = Astro.props;
const raw = import.meta.glob('../assets/icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const src = raw[`../assets/icons/${slug}.svg`] ?? '';
const svg = src
  .replace(/<\?xml[^>]*>/, '')
  .replace(/<title>.*?<\/title>/s, '')
  .replace(/<defs>.*?<\/defs>/s, '')
  .replace(/\s(id|data-name)="[^"]*"/g, '')
  .replace(/class="cls-\d+"/g, 'fill="currentColor"')
  .replace(/#(6dcff6|6dcef5|82ca9c|fcbc86)/gi, 'currentColor')
  .replace(/<svg[^>]*>/, (tag) => tag.replace(/\s(width|height)="[^"]*"/g, ''))
  .replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---
<span class:list={['micon', cls]} set:html={svg} />
<style>
  .micon { display: inline-block; width: 1em; height: 1em; flex: none; }
  .micon :global(svg) { width: 100%; height: 100%; display: block; overflow: visible; }
</style>
