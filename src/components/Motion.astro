---
// Scroll motion shared by the story pages: parallax layers ([data-par="0.2"]) and count-up numbers ([data-count]).
---
<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const layers = [...document.querySelectorAll<HTMLElement>('[data-par]')];
  if (!reduce && layers.length) {
    let ticking = false;
    const run = () => {
      const vh = innerHeight;
      for (const el of layers) {
        const box = (el.parentElement ?? el).getBoundingClientRect();
        if (box.bottom < -200 || box.top > vh + 200) continue;
        const k = Number(el.dataset.par) || 0.15;
        // Never move further than the layer overhangs its frame, so no edge shows.
        const room = Math.max(0, (el.offsetHeight - box.height) / 2) || box.height * 0.08;
        const y = Math.max(-room, Math.min(room, (box.top + box.height / 2 - vh / 2) * -k));
        el.style.transform = `translate3d(0, ${y.toFixed(1)}px, 0)`;
      }
      ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(run); } }, { passive: true });
    addEventListener('resize', run);
    run();
  }
  const nums = [...document.querySelectorAll<HTMLElement>('[data-count]')];
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    io.unobserve(e.target);
    const el = e.target as HTMLElement, end = Number(el.dataset.count), t0 = performance.now(), dur = 1400;
    if (reduce || !end) return;
    const step = (t: number) => { const p = Math.min(1, (t - t0) / dur); el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3)))); if (p < 1) requestAnimationFrame(step); };
    el.textContent = '0';
    requestAnimationFrame(step);
  }), { threshold: 0.6 });
  nums.forEach((n) => io.observe(n));
</script>
