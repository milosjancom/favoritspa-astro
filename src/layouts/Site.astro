---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Logo from '../components/Logo.astro';
import ModelIcon from '../components/ModelIcon.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import storyImg from '../assets/products/pearl/gallery-1.jpg';
import { lines } from '../data/site';
import { company, euro } from '../data/site';
import { t, url, available, langNames, meta, persons, guideUrl, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  alt: Record<Lang, string>; // the same page in each language
  overlay?: boolean;         // header sits over a full-bleed hero
  image?: string;
}
const { lang, title, description, alt, overlay = false, image } = Astro.props;
const tr = t(lang);
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const phone = company.phones[0];
const main = [
  { href: url(lang, 'models'), label: tr('nav.models') },
  { href: url(lang, 'features'), label: tr('nav.features') },
  { href: url(lang, 'maintenance'), label: tr('nav.maintenance') },
  { href: url(lang, 'contact'), label: tr('nav.contact') },
];
const more = [
  { href: url(lang, 'gallery'), label: tr('nav.gallery') },
  { href: url(lang, 'reviews'), label: tr('nav.reviews') },
  { href: url(lang, 'about'), label: tr('nav.about') },
  { href: url(lang, 'why' as RouteKey), label: tr('nav.why') },
  { href: url(lang, 'control' as RouteKey), label: tr('nav.control') },
  { href: url(lang, 'brochure' as RouteKey), label: tr('nav.brochure') },
  { href: url(lang, 'support'), label: tr('nav.support') },
];
const help = [
  { href: url(lang, 'support'), label: tr('nav.support') },
  { href: guideUrl(lang), label: tr('nav.guide') },
  { href: url(lang, 'docs'), label: tr('nav.docs') },
  { href: url(lang, 'faq'), label: tr('nav.faq') },
  { href: url(lang, 'maintenance'), label: tr('nav.maintenance') },
  { href: url(lang, 'contact'), label: tr('nav.contact') },
  { href: url(lang, 'terms'), label: tr('nav.terms') },
  { href: url(lang, 'privacy' as RouteKey), label: tr('nav.privacy') },
];
const explore = [
  { href: url(lang, 'models'), label: tr('nav.models') },
  { href: url(lang, 'features'), label: tr('nav.features') },
  { href: url(lang, 'control' as RouteKey), label: tr('nav.control') },
  { href: url(lang, 'gallery'), label: tr('nav.gallery') },
  { href: url(lang, 'reviews'), label: tr('nav.reviews') },
  { href: url(lang, 'about'), label: tr('nav.about') },
  { href: url(lang, 'why' as RouteKey), label: tr('nav.why') },
];
const menuGroups = [
  { h: tr('footer.explore'), links: [
    { href: url(lang, 'models'), label: tr('nav.models') },
    { href: url(lang, 'features'), label: tr('nav.features') },
    { href: url(lang, 'control' as RouteKey), label: tr('nav.control') },
    { href: url(lang, 'why' as RouteKey), label: tr('nav.why') },
    { href: url(lang, 'brochure' as RouteKey), label: tr('nav.brochure') },
  ] },
  { h: tr('nav.groupStory'), links: [
    { href: url(lang, 'about'), label: tr('nav.about') },
    { href: url(lang, 'gallery'), label: tr('nav.gallery') },
    { href: url(lang, 'reviews'), label: tr('nav.reviews') },
    { href: url(lang, 'contact'), label: tr('nav.contact') },
  ] },
  { h: tr('nav.groupHelp'), links: [
    { href: url(lang, 'support'), label: tr('nav.support') },
    { href: guideUrl(lang), label: tr('nav.guide') },
    { href: url(lang, 'docs'), label: tr('nav.docs') },
    { href: url(lang, 'faq'), label: tr('nav.faq') },
    { href: url(lang, 'maintenance'), label: tr('nav.maintenance') },
  ] },
];
const megaTubs = [
  { href: url(lang, 'models'), label: tr('nav.models'), icon: 'circles-three' },
  { href: url(lang, 'features'), label: tr('nav.features'), icon: 'sparkle' },
  { href: url(lang, 'control' as RouteKey), label: tr('nav.control'), icon: 'sliders-horizontal' },
  { href: url(lang, 'brochure' as RouteKey), label: tr('nav.brochure'), icon: 'book-open-text' },
];
const megaHelp = [
  { href: url(lang, 'support'), label: tr('nav.support'), icon: 'lifebuoy' },
  { href: guideUrl(lang), label: tr('nav.guide'), icon: 'book-open-text' },
  { href: url(lang, 'docs'), label: tr('nav.docs'), icon: 'file-pdf' },
  { href: url(lang, 'faq'), label: tr('nav.faq'), icon: 'question' },
  { href: url(lang, 'maintenance'), label: tr('nav.maintenance'), icon: 'drop-half' },
];
const megaStory = [
  { href: url(lang, 'about'), label: tr('nav.about'), icon: 'flower-lotus' },
  { href: url(lang, 'why' as RouteKey), label: tr('nav.why'), icon: 'shield-check' },
  { href: url(lang, 'gallery'), label: tr('nav.gallery'), icon: 'sun-horizon' },
  { href: url(lang, 'reviews'), label: tr('nav.reviews'), icon: 'chat-circle-text' },
  { href: url(lang, 'contact'), label: tr('nav.contact'), icon: 'map-pin' },
];
const path = Astro.url.pathname;
const cta = url(lang, 'quote');
const canonical = new URL(path, Astro.site);
const langList = available.filter((l) => alt[l]);
// Structured data for search engines and AI assistants: who we are, where, how to reach us.
const site = Astro.site!.toString().replace(/\/$/, '');
const orgLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${site}/#org`,
  name: 'Favorit SPA',
  legalName: company.name,
  url: `${site}/`,
  logo: `${site}/favicon-192.png`,
  image: `${site}/favicon-192.png`,
  description: 'Favorit SPA is a small European manufacturer of hot tubs (spa, jacuzzi) from Šabac, Serbia, making seven models for 2 to 6 people for 30 years.',
  email: company.email,
  telephone: company.phones[0].display,
  address: { '@type': 'PostalAddress', streetAddress: company.street, addressLocality: company.city, postalCode: '15000', addressCountry: 'RS' },
  areaServed: ['RS', 'ME', 'BA', 'HR', 'SI', 'HU', 'DE', 'AT', 'AL', 'SE', 'GR'],
  contactPoint: company.phones.map((p) => ({ '@type': 'ContactPoint', telephone: p.display, contactType: 'sales', areaServed: { Serbia: 'RS', Montenegro: 'ME', Bosnia: 'BA', Croatia: 'HR' }[p.key] })),
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'] },
  knowsLanguage: available.map((l) => meta(l).htmlLang),
};
---
<!doctype html>
<html lang={meta(lang).htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    // Apply saved display settings before first paint.
    try { var d = document.documentElement, th = localStorage.getItem('theme'), tx = localStorage.getItem('text'); if (th && th !== 'light') d.dataset.theme = th; if (tx) d.dataset.text = tx; } catch (e) {}
  </script>
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  {langList.map((l) => <link rel="alternate" hreflang={meta(l).hreflang} href={new URL(alt[l], Astro.site)} />)}
  <link rel="alternate" hreflang="x-default" href={new URL(alt.en, Astro.site)} />
  <meta name="theme-color" content="#eee8dd" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/favicon-192.png" />
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <slot name="head" />
</head>
<body class:list={{ 'has-overlay': overlay }}>
  <a class="skip" href="#main">{tr('skip')}</a>

  <header class:list={['top', { 'is-solid': !overlay }]} data-top>
    <a href={url(lang)} class="brand" aria-label="Favorit SPA"><Logo /></a>
    <nav class="nav" aria-label={tr('nav.menu')} data-mega>
      <div class="nd">
        <button type="button" class="nd-btn" aria-expanded="false" aria-controls="nd-tubs">{tr('nav.models')}<Icon name="caret-down" class="nd-caret" /></button>
        <div class="nd-panel nd-wide" id="nd-tubs">
          <div class="nd-in">
            <ul class="nd-tubs">
              {products.map((p, i) => (
                <li class={`line-${lines[p.data.line].key}`} style={`--i:${i}`}><a href={url(lang, 'models', p.data.slug)} aria-current={path.startsWith(url(lang, 'models', p.data.slug)) ? 'page' : undefined}>
                  <span class="nt-img"><Image src={p.data.plan} alt="" width={240} format="webp" quality={80} loading="lazy" /></span>
                  <span class="nt-name"><span class="nt-ic"><ModelIcon slug={p.data.slug} /></span>{p.data.name}</span>
                  <span class="nt-meta">{persons(lang)(p.data.persons)}</span>
                  <span class="nt-price">{tr('from')} {euro(p.data.fromPrice, lang)}</span>
                </a></li>
              ))}
            </ul>
            <ul class="nd-links">
              {megaTubs.map((n, i) => <li style={`--i:${i + 3}`}><a href={n.href}><span class="nd-ic"><Icon name={n.icon} /></span>{n.label}</a></li>)}
              <li style="--i:7"><a class="btn btn-ink nd-cta" href={cta}>{tr('cta')}<Icon name="arrow-right" /></a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="nd">
        <button type="button" class="nd-btn" aria-expanded="false" aria-controls="nd-help">{tr('nav.groupHelp')}<Icon name="caret-down" class="nd-caret" /></button>
        <div class="nd-panel" id="nd-help">
          <div class="nd-in nd-focus">
            <div class="nd-intro" style="--i:0">
              <p class="nd-eyebrow">{tr('nav.groupHelp')}</p>
              <p class="nd-lead">{tr('nav.helpIntro')}</p>
              <a class="nd-more" href={url(lang, 'support')}>{tr('nav.support')}<Icon name="arrow-right" /></a>
            </div>
            <ul class="nd-links">{megaHelp.map((n, i) => <li style={`--i:${i + 1}`}><a href={n.href}><span class="nd-ic"><Icon name={n.icon} /></span><span class="nd-t">{n.label}</span></a></li>)}</ul>
            <div class="nd-card nd-aside" style="--i:6">
              <p class="nd-eyebrow">{tr('nav.contact')}</p>
              <a class="nd-big" href={`tel:${phone.tel}`}><Icon name="phone" />{phone.display}</a>
              <a href={`mailto:${company.email}`}><Icon name="envelope-simple" />{company.email}</a>
              <span class="nd-note"><Icon name="clock" />{tr('footer.visitNote')}</span>
            </div>
          </div>
        </div>
      </div>
      <div class="nd">
        <button type="button" class="nd-btn" aria-expanded="false" aria-controls="nd-story">{tr('nav.groupStory')}<Icon name="caret-down" class="nd-caret" /></button>
        <div class="nd-panel" id="nd-story">
          <div class="nd-in nd-focus">
            <div class="nd-intro" style="--i:0">
              <p class="nd-eyebrow">{tr('nav.groupStory')}</p>
              <p class="nd-lead">{tr('nav.storyIntro')}</p>
              <a class="nd-more" href={url(lang, 'about')}>{tr('nav.about')}<Icon name="arrow-right" /></a>
            </div>
            <ul class="nd-links">{megaStory.map((n, i) => <li style={`--i:${i + 1}`}><a href={n.href}><span class="nd-ic"><Icon name={n.icon} /></span><span class="nd-t">{n.label}</span></a></li>)}</ul>
            <a class="nd-photo nd-aside" style="--i:6" href={url(lang, 'about')}>
              <Image src={storyImg} alt="" width={640} format="webp" quality={76} loading="lazy" />
              <span class="nd-photo-cap"><span>{company.street}, {company.city}</span><span class="nd-map"><Icon name="map-pin" />{tr('contact.map')}</span></span>
            </a>
          </div>
        </div>
      </div>
    </nav>
    <div class="tools">
      <details class="lang-dd" data-dd>
        <summary aria-label={tr('nav.lang')}><Icon name="globe-simple" /><span>{lang.toUpperCase()}</span><Icon name="caret-down" class="dd-caret" /></summary>
        <ul class="dd-list">
          {langList.map((l) => <li><a href={alt[l]} hreflang={meta(l).hreflang} lang={meta(l).htmlLang} aria-current={l === lang ? 'true' : undefined} data-lang={l}><span>{langNames[l]}</span><span class="dd-code">{l.toUpperCase()}</span></a></li>)}
        </ul>
      </details>
      <a class="btn cta" href={cta}>{tr('cta')}</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="menu" data-burger data-close={tr('nav.closeShort')}>
        <span class="burger-lines" aria-hidden="true"><span></span><span></span></span>
        <span class="burger-label">{tr('nav.menu')}</span>
      </button>
    </div>
  </header>

  <div class="mega-veil" aria-hidden="true"></div>
  <div class="menu" id="menu" role="dialog" aria-modal="true" aria-label={tr('nav.menu')} hidden data-menu>
    <div class="menu-inner">
      <div class="menu-left">
        <nav class="menu-cols" aria-label={tr('nav.menu')}>
          {menuGroups.map((g, gi) => (
            <div class="menu-col">
              <p class="menu-label">{g.h}</p>
              <ul>{g.links.map((n, i) => <li><a href={n.href} style={`--i:${gi * 2 + i}`} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}</ul>
            </div>
          ))}
        </nav>
        <div class="menu-bottom">
          <div class="menu-contact">
            <a href={`tel:${phone.tel}`}>{phone.display}</a>
            <a href={`mailto:${company.email}`}>{company.email}</a>
            <span>{company.street}, {company.city}</span>
            <a class="btn btn-ink menu-cta" href={cta}>{tr('cta')}</a>
          </div>
          <div class="settings">
            <p class="menu-label">{tr('settings.title')}</p>
            <div class="set-row" role="group" aria-label={tr('settings.theme')}>
              <span class="set-name">{tr('settings.theme')}</span>
              <div class="seg">
                <button type="button" data-theme-set="" aria-pressed="false"><Icon name="sun" /><span>{tr('settings.light')}</span></button>
                <button type="button" data-theme-set="dark" aria-pressed="false"><Icon name="moon" /><span>{tr('settings.dark')}</span></button>
                <button type="button" data-theme-set="auto" aria-pressed="false"><span>{tr('settings.auto')}</span></button>
              </div>
            </div>
            <div class="set-row" role="group" aria-label={tr('settings.text')}>
              <span class="set-name">{tr('settings.text')}</span>
              <div class="seg seg-text">
                <button type="button" data-text-set="" aria-pressed="false" aria-label={tr('settings.smaller')}><span style="font-size:0.9em">A</span></button>
                <button type="button" data-text-set="l" aria-pressed="false" aria-label={tr('settings.larger')}><span style="font-size:1.1em">A</span></button>
                <button type="button" data-text-set="xl" aria-pressed="false" aria-label={tr('settings.largest')}><span style="font-size:1.32em">A</span></button>
              </div>
            </div>
            <div class="set-row">
              <span class="set-name">{tr('nav.lang')}</span>
              <details class="lang-dd lang-dd-menu" data-dd>
                <summary><Icon name="globe-simple" /><span>{langNames[lang]}</span><Icon name="caret-down" class="dd-caret" /></summary>
                <ul class="dd-list">
                  {langList.map((l) => <li><a href={alt[l]} hreflang={meta(l).hreflang} lang={meta(l).htmlLang} aria-current={l === lang ? 'true' : undefined} data-lang={l}><span>{langNames[l]}</span><span class="dd-code">{l.toUpperCase()}</span></a></li>)}
                </ul>
              </details>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <main id="main"><slot /></main>

  <footer class="foot">
    <div class="foot-top">
      <p class="foot-big">{tr('footer.big')}</p>
      <div class="foot-ctas">
        <a class="btn btn-ink" href={cta}>{tr('cta')}<Icon name="arrow-right" /></a>
        <a class="btn" href={url(lang, 'contact')}>{tr('maker.cta')}</a>
      </div>
    </div>
    <div class="foot-cols">
      <nav aria-labelledby="f-models">
        <h2 id="f-models" class="f-h">{tr('footer.models')}</h2>
        <ul>{products.map((p) => <li><a href={url(lang, 'models', p.data.slug)}><span class="f-ic"><ModelIcon slug={p.data.slug} /></span>{p.data.name}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="f-explore">
        <h2 id="f-explore" class="f-h">{tr('footer.explore')}</h2>
        <ul>{explore.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="f-help">
        <h2 id="f-help" class="f-h">{tr('footer.help')}</h2>
        <ul>{help.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </nav>
      <div>
        <h2 class="f-h">{tr('footer.visit')}</h2>
        <p>{company.name}<br />{company.street}<br />{company.city}, {tr('country')}</p>
        <p class="muted">{tr('footer.visitNote')}</p>
        <ul class="f-links">
          <li><a href={company.mapUrl} rel="noopener"><Icon name="map-pin" />{tr('contact.map')}</a></li>
          <li><a href={`mailto:${company.email}`}><Icon name="envelope-simple" />{company.email}</a></li>
          <li><a href={url(lang, 'brochure' as RouteKey)}><Icon name="file-pdf" />{tr('footer.catalog')}</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-mark"><Logo /></div>
    <div class="foot-legal">
      <span>© {new Date().getFullYear()} Favorit SPA · {tr('footer.note')}</span>
      <span class="f-legal-links">
        <a href={url(lang, 'terms')}>{tr('nav.terms')}</a>
        <a href={url(lang, 'privacy' as RouteKey)}>{tr('nav.privacy')}</a>
        <a href={url(lang, 'support')}>{tr('nav.support')}</a>
      </span>
    </div>
  </footer>

  <script>
    // Header: transparent over a hero, solid once the page scrolls.
    // Over a hero: transparent at the very top, hidden while the hero scrolls, solid once past it.
    const top = document.querySelector<HTMLElement>('[data-top]')!;
    const overlay = document.body.classList.contains('has-overlay');
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const solid = () => {
      const open = document.body.classList.contains('menu-open');
      const end = hero ? hero.offsetTop + hero.offsetHeight - 120 : 0;
      const y = scrollY;
      const mode = open || !overlay ? 'solid' : y < 60 ? 'clear' : y < end ? 'hidden' : 'solid';
      top.classList.toggle('is-solid', mode === 'solid');
      top.classList.toggle('is-hidden', mode === 'hidden');
    };
    // Hide the inline nav when the words don't fit between logo and tools (long languages); the menu still has everything.
    const nav = top.querySelector<HTMLElement>('.nav')!;
    const brand = top.querySelector<HTMLElement>('.brand')!;
    const tools = top.querySelector<HTMLElement>('.tools')!;
    const fit = () => {
      top.classList.remove('nav-tight');
      if (getComputedStyle(nav).display === 'none') return;
      const n = nav.getBoundingClientRect();
      if (n.left < brand.getBoundingClientRect().right + 24 || n.right > tools.getBoundingClientRect().left - 24) top.classList.add('nav-tight');
    };
    fit(); addEventListener('resize', fit); document.fonts?.ready.then(fit);
    addEventListener('scroll', solid, { passive: true });
    addEventListener('resize', solid);
    solid();

    // Desktop mega menu: hover (fine pointers) or click to open, one panel at a time.
    const nds = [...top.querySelectorAll<HTMLElement>('.nd')];
    let ndTimer = 0;
    const ndSet = (target: HTMLElement | null) => {
      clearTimeout(ndTimer);
      nds.forEach((d) => { const on = d === target; d.classList.toggle('is-open', on); d.querySelector('.nd-btn')!.setAttribute('aria-expanded', String(on)); });
      top.classList.toggle('mega-open', !!target);
      document.body.classList.toggle('mega-on', !!target);
    };
    const hover = matchMedia('(hover: hover) and (pointer: fine)');
    nds.forEach((d) => {
      const b = d.querySelector<HTMLButtonElement>('.nd-btn')!;
      b.addEventListener('click', () => ndSet(d.classList.contains('is-open') ? null : d));
      d.addEventListener('pointerenter', () => { if (!hover.matches) return; clearTimeout(ndTimer); ndTimer = window.setTimeout(() => ndSet(d), top.classList.contains('mega-open') ? 0 : 120); });
      d.addEventListener('pointerleave', () => { if (!hover.matches) return; clearTimeout(ndTimer); ndTimer = window.setTimeout(() => ndSet(null), 220); });
      d.addEventListener('keydown', (e) => { if (e.key === 'Escape' && d.classList.contains('is-open')) { ndSet(null); b.focus(); } });
      d.addEventListener('focusout', (e) => { if (!d.contains(e.relatedTarget as Node)) { if (d.classList.contains('is-open') && !(e.relatedTarget as HTMLElement)?.closest?.('.nd')) ndSet(null); } });
    });
    document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.nd')) ndSet(null); });
    addEventListener('resize', () => ndSet(null));

    // Remember an explicit language choice for the root redirect.
    document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach((a) =>
      a.addEventListener('click', () => { try { localStorage.setItem('lang', a.dataset.lang!); } catch {} }));

    // Fullscreen menu.
    const btn = document.querySelector<HTMLButtonElement>('[data-burger]')!;
    const menu = document.querySelector<HTMLElement>('[data-menu]')!;
    const label = btn.querySelector('.burger-label')!;
    const openText = label.textContent;
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('menu-open', open);
      label.textContent = open ? btn.dataset.close ?? '' : openText;
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-open'));
        menu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
      } else {
        menu.classList.remove('is-open');
        setTimeout(() => { if (!menu.classList.contains('is-open')) menu.hidden = true; }, 500);
        btn.focus({ preventScroll: true });
      }
      solid();
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

    // Language dropdowns: close on outside click or Escape.
    const dds = [...document.querySelectorAll<HTMLDetailsElement>('[data-dd]')];
    document.addEventListener('click', (e) => dds.forEach((d) => { if (d.open && !d.contains(e.target as Node)) d.open = false; }));
